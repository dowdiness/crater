{
  "is-main": true,
  "import": [
    "justjavac/webview"
  ],
  "supported-targets": ["native"],
  "targets": {
    "main.mbt": ["native"]
  },
  "link": {
    "native": {
      "cc-flags": "-fwrapv -fsanitize=address -fsanitize=undefined",
      "cc-link-flags": "-L.mooncakes/justjavac/webview/lib -lwebview -Wl,-rpath,.mooncakes/justjavac/webview/lib"
    }
  }
}
